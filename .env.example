# Copy this file to .env before running `docker compose up --build`.
# Values here are placeholders only - never commit a real .env file (see .gitignore).
# Per-service database users/passwords are fixed in scripts/db/init.sql for local
# development; only the MySQL root password and a few tunable timeouts are overridable
# here.

MYSQL_ROOT_PASSWORD=rootpass

# Shared / tunable settings (all have sane defaults in docker-compose.yml if unset)
HOLD_SECONDS=30
EXPIRY_INTERVAL_SECONDS=5
GATEWAY_TIMEOUT_SECONDS=5
SEAT_PRICE=250.00
MAX_SEATS_PER_BOOKING=6
SERVICE_TIMEOUT_SECONDS=3
PAYMENT_TIMEOUT_SECONDS=8
PAY_LOCK_TTL_SECONDS=60
