erDiagram
    bookings ||--|{ booking_seats : "has"
    bookings {
        varchar id PK "UUID, generated by Booking"
        int event_id "owned by Seat service, no FK across DBs"
        varchar customer_email
        decimal amount "server-computed, never from client"
        varchar status "HELD or CONFIRMED or CANCELLED or EXPIRED"
        datetime hold_expires_at
        varchar pay_lock "Idempotency-Key of payment in flight"
        datetime pay_locked_at
        varchar payment_id "owned by Payment service, no FK across DBs"
        datetime created_at
        datetime updated_at
    }
    booking_seats {
        varchar booking_id PK
        varchar seat_no PK "owned by Seat service, no FK across DBs"
    }
    idempotency_keys {
        varchar idem_key PK "BR4: one row per key"
        varchar booking_id
        varchar request_hash "SHA-256 of method plus path plus body"
        varchar status "IN_PROGRESS or DONE"
        int response_code
        text response_body
        datetime created_at
        datetime updated_at
    }
