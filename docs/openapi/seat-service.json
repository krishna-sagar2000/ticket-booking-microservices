{
  "openapi": "3.1.0",
  "info": {
    "title": "Seat Service",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{event_id}/seats": {
      "get": {
        "tags": [
          "seats"
        ],
        "summary": "List the seats of an event and their status",
        "operationId": "list_seats_api_v1_events__event_id__seats_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Request is not valid",
            "content": {
              "application/json": {
                "example": {
                  "code": "VALIDATION_ERROR",
                  "message": "Request is not valid",
                  "correlationId": "c0ffee-42"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Event does not exist",
            "content": {
              "application/json": {
                "example": {
                  "code": "EVENT_NOT_FOUND",
                  "message": "Event 99 does not exist",
                  "correlationId": "c0ffee-42"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seats/hold": {
      "post": {
        "tags": [
          "seats"
        ],
        "summary": "Hold seats for a booking, all or none (BR1)",
        "operationId": "hold_api_v1_seats_hold_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "VALIDATION_ERROR",
                  "message": "Request is not valid",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          },
          "404": {
            "description": "Event or seat does not exist (EVENT_NOT_FOUND / SEAT_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "SEAT_NOT_FOUND",
                  "message": "Seat Z9 does not exist for event 1",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          },
          "409": {
            "description": "A seat is already held or sold; nothing was held",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "SEAT_UNAVAILABLE",
                  "message": "Seat A1 is already held",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seats/confirm": {
      "post": {
        "tags": [
          "seats"
        ],
        "summary": "Turn this booking's held seats into SOLD",
        "operationId": "confirm_api_v1_seats_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "VALIDATION_ERROR",
                  "message": "Request is not valid",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          },
          "404": {
            "description": "Event or seat does not exist (EVENT_NOT_FOUND / SEAT_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "SEAT_NOT_FOUND",
                  "message": "Seat Z9 does not exist for event 1",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          },
          "409": {
            "description": "Hold expired or seats not held by this booking; nothing was sold",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "HOLD_EXPIRED",
                  "message": "The hold has expired",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seats/release": {
      "post": {
        "tags": [
          "seats"
        ],
        "summary": "Free this booking's held seats (SOLD seats are never freed)",
        "operationId": "release_api_v1_seats_release_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "VALIDATION_ERROR",
                  "message": "Request is not valid",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          },
          "404": {
            "description": "Event or seat does not exist (EVENT_NOT_FOUND / SEAT_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "code": "SEAT_NOT_FOUND",
                  "message": "Seat Z9 does not exist for event 1",
                  "correlationId": "c0ffee-42"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seats/expire-holds": {
      "post": {
        "tags": [
          "seats"
        ],
        "summary": "Run the BR2 expiry sweep now (the background job also runs it)",
        "operationId": "expire_holds_api_v1_seats_expire_holds_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlationId": {
            "type": "string",
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "title": "ErrorBody",
        "description": "The shared error format (app/errors.py), listed here so the OpenAPI docs show it."
      },
      "SeatRequest": {
        "properties": {
          "bookingId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Bookingid",
            "examples": [
              "b-123"
            ]
          },
          "eventId": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Eventid",
            "examples": [
              1
            ]
          },
          "seats": {
            "items": {
              "type": "string",
              "maxLength": 10,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Seats",
            "examples": [
              [
                "A1",
                "A2"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "bookingId",
          "eventId",
          "seats"
        ],
        "title": "SeatRequest",
        "description": "Body of hold / confirm / release: which seats of which event, for which booking."
      }
    }
  }
}
